<script lang="ts">
import { signal, computed } from '@angular/core';
import { injectContentFiles } from '@analogjs/content';
import PostAttributes from '../../post-attributes';
import { RouteMeta } from '@analogjs/router';
import { RouterLink } from '@angular/router';
import { DatePipe } from '@angular/common';
import { injectQueryParams } from 'ngxtension/inject-query-params';
import { Breadcrumbs } from '../../components/breadcrumb.component';

defineMetadata({
  imports: [RouterLink, DatePipe, Breadcrumbs],
});

export const routeMeta: RouteMeta = {
  title: 'All Blog Posts - justangular.com',
};

const allPosts = injectContentFiles<PostAttributes>()
  .filter((article) => new Date() > new Date(article.attributes.publishedAt))
  .sort((a1, a2) =>
    a1.attributes.publishedAt > a2.attributes.publishedAt ? -1 : 1
  );

// Top tags by frequency, for the filter row.
const tagCounts = new Map<string, number>();
allPosts.forEach((p) =>
  (p.attributes.tags ?? []).forEach((t) =>
    tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)
  )
);
const allTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag)
  .slice(0, 12);

const tagParam = injectQueryParams('tag');
const search = signal('');
const activeTag = signal<string | null>((tagParam() as string) ?? null);

const filteredPosts = computed(() => {
  const q = search().toLowerCase().trim();
  const tag = activeTag();
  return allPosts.filter((p) => {
    const tags = p.attributes.tags ?? [];
    const matchesTag = !tag || tags.includes(tag);
    const haystack = (
      p.attributes.title +
      ' ' +
      p.attributes.description +
      ' ' +
      tags.join(' ')
    ).toLowerCase();
    return matchesTag && (!q || haystack.includes(q));
  });
});

function onSearch(event: Event) {
  search.set((event.target as HTMLInputElement).value);
}

function selectTag(tag: string | null) {
  activeTag.set(tag);
}
</script>

<template>
  <div class="w-full hidden md:block">
    <app-breadcrumbs [breadcrumbs]="[{ url: '/blog', label: 'Blog' }]" />
  </div>

  <div class="mx-auto max-w-6xl px-6 lg:px-8 py-14 sm:py-20">
    <!-- Header -->
    <header class="max-w-3xl">
      <p class="eyebrow">The archive</p>
      <h1 class="mt-3 font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink">
        Angular insights &amp; tutorials
      </h1>
      <p class="mt-5 text-lg leading-8 text-muted">
        {{ allPosts.length }} articles on signals, change detection, resources, forms,
        SSR and everything in between — from first principles to the sharp edges.
      </p>
    </header>

    <!-- Toolbar: search + tag filters -->
    <div class="mt-10 space-y-5">
      <div class="relative max-w-md">
        <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-muted"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
        </svg>
        <input
          type="search"
          placeholder="Search articles…"
          [value]="search()"
          (input)="onSearch($event)"
          class="w-full rounded-full border border-hairline bg-surface pl-11 pr-4 py-3 text-ink placeholder:text-muted outline-none focus:border-ink/30 focus:ring-2 focus:ring-accent/20 transition"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="chip" [attr.data-active]="!activeTag()" (click)="selectTag(null)">
          All
        </button>
        @for (tag of allTags; track tag) {
          <button type="button" class="chip" [attr.data-active]="activeTag() === tag" (click)="selectTag(tag)">
            {{ tag }}
          </button>
        }
      </div>
    </div>

    <!-- Result count -->
    <p class="mt-8 text-sm text-muted">
      Showing <span class="font-semibold text-ink">{{ filteredPosts().length }}</span>
      @if (activeTag()) { in <span class="font-semibold text-ink">{{ activeTag() }}</span> }
      @if (search()) { matching “<span class="font-semibold text-ink">{{ search() }}</span>” }
    </p>

    <!-- Grid -->
    @if (filteredPosts().length > 0) {
      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        @for (post of filteredPosts(); track post.attributes.slug) {
          <article class="group card hover-lift overflow-hidden flex flex-col">
            <a [routerLink]="[post.attributes.slug]" class="relative block aspect-[16/9] overflow-hidden bg-paper-soft">
              <img
                [src]="post.attributes.coverImage"
                [alt]="post.attributes.description"
                loading="lazy"
                style="view-transition-name: {{ post.attributes.slug }}"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </a>

            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-2 text-xs text-muted">
                <time>{{ post.attributes.publishedAt | date: 'MMM d, y' }}</time>
                @if (post.attributes.tags?.[0]) {
                  <span class="h-1 w-1 rounded-full bg-muted/50"></span>
                  <span>{{ post.attributes.tags?.[0] }}</span>
                }
              </div>

              <h2 class="mt-2 font-serif text-2xl font-semibold leading-snug text-ink group-hover:text-accent transition-colors">
                <a [routerLink]="[post.attributes.slug]">
                  <span class="absolute inset-0"></span>
                  {{ post.attributes.title }}
                </a>
              </h2>

              <p class="mt-2.5 text-muted leading-7 line-clamp-2">
                {{ post.attributes.description }}
              </p>

              <div class="mt-4 flex items-center gap-2 pt-4 border-t border-hairline">
                <span class="text-sm font-semibold text-ink group-hover:text-accent transition-colors inline-flex items-center gap-1">
                  Read article
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </div>
            </div>
          </article>
        }
      </div>
    } @else {
      <div class="mt-10 rounded-2xl border border-dashed border-hairline p-16 text-center">
        <p class="font-serif text-2xl text-ink">No articles found</p>
        <p class="mt-2 text-muted">Try a different search term or clear the filters.</p>
        <button type="button" class="btn btn-ghost mt-6" (click)="selectTag(null); search.set('')">
          Clear filters
        </button>
      </div>
    }

    <!-- CTA -->
    <div class="mt-20 relative overflow-hidden rounded-3xl border border-hairline bg-ink px-8 py-12 sm:px-14 text-center">
      <h3 class="font-serif text-2xl sm:text-3xl font-semibold text-paper">Stay in the loop</h3>
      <p class="mx-auto mt-3 max-w-xl text-paper/70">
        The latest Angular deep dives, the moment they're published.
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href="https://twitter.com/Enea_Jahollari" target="_blank" rel="noopener"
           class="btn bg-paper text-ink hover:-translate-y-0.5">Follow on Twitter ↗</a>
        <a href="https://github.com/eneajahollari" target="_blank" rel="noopener"
           class="btn border border-paper/25 text-paper hover:bg-paper/10 hover:-translate-y-0.5">GitHub ↗</a>
      </div>
    </div>
  </div>
</template>
